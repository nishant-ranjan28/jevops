# ---------------------------------------------------------------------------
# JevOps configuration  —  copy to .env.local
#
#     cp env.example .env.local
#
# Everything here is optional. With no keys set, the app runs a deterministic
# mock model: the full pipeline works offline and produces identical output on
# every run, which is what you want for a live demo.
# ---------------------------------------------------------------------------

# Which provider to try FIRST: openrouter | groq | mock
# Leave unset to auto-select whichever key is present.
#
# Providers are a failover chain, not a single choice. If both keys are set,
# the other one is kept on standby: when the primary is down, rate limited, or
# has lost the model you asked for, the next takes over and the run completes.
# The chain always ends with the deterministic mock, so a demo never dies on
# someone else's outage. Set this to `mock` to pin mock mode; requests cannot
# override it.
LLM_PROVIDER=

# Let /api/analyze requests choose `provider` and `model` (1 to enable). Leave
# unset on any public deployment, or visitors can spend your keys on any model.
ALLOW_CLIENT_PROVIDER_OVERRIDE=

# --- OpenRouter -------------------------------------------------------------
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000

# --- Groq -------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- GitHub (live PR review) ------------------------------------------------
# Entirely optional. Public pull requests work with no token at all.
# Without one GitHub allows 60 API requests an hour per IP; with one, 5000.
# A fine-grained token with PUBLIC REPO READ access is enough. Read
# server-side only — it is never sent to the browser.
GITHUB_TOKEN=

# Override the GitHub API root (GitHub Enterprise, or a test double).
# GITHUB_API_URL=https://api.github.com
